---
---
<section class="bookmark-manager" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Add a link with or without <code>https://</code> to create its short <code>mona-</code> slug.</p>
  <p id="status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import {
    formatBookmark,
    loadBookmarks,
    normalizeBookmarkUrl,
  } from '../lib/bookmarks.mjs';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const bookmarkList = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('status');
  let bookmarks = [];

  function showMessage(message) {
    if (status) status.textContent = message;
  }

  function readBookmarks() {
    try {
      return loadBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      showMessage('Browser storage is unavailable. Bookmarks will not persist after this visit.');
      return [];
    }
  }

  function persistBookmarks() {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(bookmarks));
      return true;
    } catch {
      showMessage('Could not save to browser storage. This bookmark may not persist after this visit.');
      return false;
    }
  }

  function makeSlug() {
    const alphabet = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const randomBytes = new Uint8Array(4);
    try {
      window.crypto.getRandomValues(randomBytes);
    } catch {
      for (let index = 0; index < randomBytes.length; index += 1) {
        randomBytes[index] = Math.floor(Math.random() * 256);
      }
    }
    const suffix = Array.from(randomBytes, (byte) => alphabet[byte % alphabet.length]).join('');
    return `mona-${suffix}`;
  }

  function renderBookmarks() {
    if (!bookmarkList || !emptyState || !listHeader) return;
    bookmarkList.replaceChildren();

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showMessage(`Copied ${bookmark.slug}.`);
        } catch {
          showMessage('Could not copy the slug. Select and copy it manually.');
        }
      });

      item.append(link, separator, slug, copyButton);
      bookmarkList.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const url = normalizeBookmarkUrl(urlInput?.value);
      if (!url) {
        showMessage('Enter a valid web address, such as example.com.');
        urlInput?.focus();
        return;
      }

      let slug = makeSlug();
      while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
        slug = makeSlug();
      }
      bookmarks = [...bookmarks, { url, slug }];
      persistBookmarks();
      renderBookmarks();
      if (urlInput) urlInput.value = '';
      showMessage(`Saved ${formatBookmark({ url, slug })}.`);
    } catch {
      showMessage('Could not add that bookmark. Please try again.');
    }
  });

  document.getElementById('clear-all')?.addEventListener('click', () => {
    try {
      if (!window.confirm('Clear all saved bookmarks?')) return;
      bookmarks = [];
      persistBookmarks();
      renderBookmarks();
      showMessage('All bookmarks cleared.');
    } catch {
      showMessage('Could not clear the saved bookmarks.');
    }
  });

  bookmarks = readBookmarks();
  renderBookmarks();
</script>

<style>
  .bookmark-manager {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background: color-mix(in srgb, Canvas 94%, var(--accent) 6%);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 8%, transparent);
  }

  form { margin-top: 0; }
  input { background: Canvas; }
  button[type='submit'] { box-shadow: 0 0.25rem 0.75rem color-mix(in srgb, var(--accent) 25%, transparent); }
  .hint { margin-bottom: 1rem; }
  .hint code { color: var(--accent); }
  .status { min-height: 1.25rem; margin: 0 0 0.5rem; font-size: 0.8rem; color: var(--muted); }
  #list-header[hidden] { display: none; }
  .empty { background: color-mix(in srgb, Canvas 80%, transparent); }

  li.bookmark {
    background: Canvas;
    box-shadow: 0 0.2rem 0.6rem color-mix(in srgb, currentColor 5%, transparent);
  }

  .bookmark .url { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .bookmark .separator { white-space: pre; color: var(--muted); }
  .bookmark .slug { font-family: var(--font-body); font-weight: 600; }

  @media (max-width: 32rem) {
    .bookmark-manager { padding: 1rem; }
    form { align-items: stretch; }
    form button[type='submit'] { width: 100%; }
  }
</style>
